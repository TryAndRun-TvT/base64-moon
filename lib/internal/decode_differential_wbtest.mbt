// 白盒（包**内**）：**内核 `decode_into` 的差分基线**。
//
// 【这个文件为什么存在】
// [S9 §4.3](docs/01-规格/S9-M5语义矩阵与32位装载裁决.md) 把「去内循环」登记为
// **待独立落地**的性能项，落地纪律是**先做差分基线、再改实现**
// （[S4 §9.3](docs/01-规格/S4-实施规格与落地顺序.md)：MoonBit 没有「同装两版包」，
// 故把**当前输出写成字面量**当黄金值）。
//
// 【为什么必须放在 `lib/internal/`（而不是 `lib/` 的黑盒文件）】
// 要锁的是 `decode_into`——它是**本包私有**。黑盒只能经 `@lib` 的物化层，
// 会把「缓冲分配 / `Engine::new` 建表」混进来，失去「同层比较」的前提
// （[S6 §1](docs/01-规格/S6-性能实测与M3裁决.md) 的分子分母纪律）。
// 公共契约那一层另锁在 `lib/base64_test.mbt` 与 `lib/base64_matrix_test.mbt`。
//
// 【黄金值出处】（AGENTS.md §三.2 铁律 1）
//   · 输入串 = CPython `base64.b64encode(det_bytes(n))`，`det_bytes(i) = (i*37+11)&0xFF`
//     （独立参照，非本库输出）；期望判定 = 同一批原始字节的 `bytes.hex()`；
//   · 生成命令：见 [S10 §5](docs/01-规格/S10-去内循环落地与端到端对照.md)。

///|
/// 注：本文件**不定义** `det_bytes`——输入是**已生成的 base64 字面量**（黄金值来源
/// 见上），故无需在运行时重算原始字节。`lib/base64_differential_test.mbt` 那边
/// 需要它（回算 hex 用），那份复用 M5 矩阵的同名实现。
//
// 台账：[S10](docs/01-规格/S10-去内循环落地与端到端对照.md) §2。

///|
/// 字节序列 → 小写十六进制串（对齐 CPython 的 `bytes.hex()`）。
fn det_to_hex(bytes : Bytes) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder()
  for i = 0; i < bytes.length(); i = i + 1 {
    let v = bytes[i].to_int()
    sb.write_char(digits[(v >> 4) & 0xF].to_int().unsafe_to_char())
    sb.write_char(digits[v & 0xF].to_int().unsafe_to_char())
  }
  sb.to_string()
}

///|
/// 走内核 `decode_into`（持 Engine、自持缓冲），返回一句「判定」。
///
/// 返回串而非 `Result`：要在**同一坐标系**里比「成功时的字节序列」与
/// 「出错时的变体名 + offset」，用串一次比完，失败时还能报出实值。
fn decode_into_verdict(engine : Engine, input : BytesView) -> String {
  let out = FixedArray::make(decoded_len_estimate(input.length()), b'\x00')
  match decode_into(engine, input, out) {
    Ok(n) => "Ok(" + det_to_hex(Bytes::from_array(out[:n])) + ")"
    Err(DecodeFailed(e)) => describe_decode_error(e)
    Err(OutputSliceTooSmall) => "OutputSliceTooSmall"
  }
}

///|
/// 内核差分：逐长度比对 `decode_into` 的判定（含 `%4` 分界与长输入）。
///
/// `keep` 的取法同 M5：`0..=16` 覆盖全部 12 种余数组合，其余点跨「整块 / 尾块」
/// 与尺寸边界。任何一格不等即红——**这就是改实现时的网**。
test "differential_decode_into_verdict" {
  let e = Engine::new(Alphabet::standard(), Config::default())
  assert_eq(decode_into_verdict(e, b""), "Ok()")
  assert_eq(decode_into_verdict(e, b"Cw=="[:]), "Ok(0b)")
  assert_eq(decode_into_verdict(e, b"CzA="[:]), "Ok(0b30)")
  assert_eq(decode_into_verdict(e, b"CzBV"[:]), "Ok(0b3055)")
  assert_eq(decode_into_verdict(e, b"CzBVeg=="[:]), "Ok(0b30557a)")
  assert_eq(decode_into_verdict(e, b"CzBVep8="[:]), "Ok(0b30557a9f)")
  assert_eq(decode_into_verdict(e, b"CzBVep/E"[:]), "Ok(0b30557a9fc4)")
  assert_eq(decode_into_verdict(e, b"CzBVep/E6Q=="[:]), "Ok(0b30557a9fc4e9)")
  assert_eq(decode_into_verdict(e, b"CzBVep/E6Q4="[:]), "Ok(0b30557a9fc4e90e)")
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4z"[:]),
    "Ok(0b30557a9fc4e90e33)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWA=="[:]),
    "Ok(0b30557a9fc4e90e3358)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWH0="[:]),
    "Ok(0b30557a9fc4e90e33587d)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWH2i"[:]),
    "Ok(0b30557a9fc4e90e33587da2)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWH2ixw=="[:]),
    "Ok(0b30557a9fc4e90e33587da2c7)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWH2ix+w="[:]),
    "Ok(0b30557a9fc4e90e33587da2c7ec)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWH2ix+wR"[:]),
    "Ok(0b30557a9fc4e90e33587da2c7ec11)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWH2ix+wRNg=="[:]),
    "Ok(0b30557a9fc4e90e33587da2c7ec1136)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YQ=="[:]),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c61)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYY="[:]),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186)",
  )
  assert_eq(
    decode_into_verdict(e, b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar"[:]),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186ab)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLE="[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW"[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+w=="[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wB"[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJg=="[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc0126)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6w=="[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQQ=="[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb10355a7fa4c9ee13385d82a7ccf1163b6085aacff4193e6388add2f71c41)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQWY="[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb10355a7fa4c9ee13385d82a7ccf1163b6085aacff4193e6388add2f71c4166)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQWaL"[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb10355a7fa4c9ee13385d82a7ccf1163b6085aacff4193e6388add2f71c41668b)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQWaLsA=="[:],
    ),
    "Ok(0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb10355a7fa4c9ee13385d82a7ccf1163b6085aacff4193e6388add2f71c41668bb0)",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
  assert_eq(
    decode_into_verdict(
      e,
      b""[:],
    ),
    "Ok()",
  )
}

///|
/// **合并判错的前提**：`acc = (b0<<18)|(b1<<12)|(b2<<6)|b3` 中
/// 「`acc < 0`」⟺「四个 morsel 里至少一个为 `-1`」。
///
/// 这条成为前提的理由：`decode_into` 的热循环把「逐符号判错」换成一次 `acc < 0`
/// （[S9 §4.1](docs/01-规格/S9-M5语义矩阵与32位装载裁决.md) 的变体 D 思路），
/// 而它成立依赖「MoonBit `Int` 为 31 位有效位 + 符号位、`-1` 位模式全 1」。
/// **写成穷举测试而不是注释**：注释会漂移，测试会红。
///
/// 覆盖 `(-1) ∪ [0,63]` 的全部 65⁴ 组合；不写「抽样」——抽样漏掉的那一格
/// 恰好是最坏情况（例如只有 `b3` 为负）。
test "merged_check_equivalence_exhaustive" {
  let mut checked = 0
  for b0 in -1..<=63 {
    for b1 in -1..<=63 {
      for b2 in -1..<=63 {
        for b3 in -1..<=63 {
          let acc = (b0 << 18) | (b1 << 12) | (b2 << 6) | b3
          let any_neg = b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0
          assert_eq(acc < 0, any_neg)
          checked += 1
        }
      }
    }
  }
  assert_eq(checked, 65 * 65 * 65 * 65)
}
