// lib/internal —— **零分配内核**（slice 进 / slice 出）。
//
// 分层依据：`docs/01-规格/S3-架构分层与子包职责.md` 的三层结构 ——
// 「内核不分配，物化在外壳」。本包照抄 rust-base64 的分层：
//   · 只接受 / 返回 `BytesView` / `FixedArray[Byte]`（零分配）；
//   · **不 import `lib`**（依赖方向无环，MoonBit 禁止 import 环）；
//   · `String` 一律不出现在签名里（`Bytes -> String` 是重解释，见 S1 §5.3）。
import {
  "moonbitlang/core/debug",
}
