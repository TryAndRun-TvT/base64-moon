// 黑盒（包**外**）：**公共契约的定值基线**（逐字面量黄金值）。
//
// 【与 `base64_matrix_test.mbt` 的分工】
// 矩阵锁的是**四条结构性不变量** + 8 个 CPython 定值——「错得一致」时它会全绿。
// 本文件补的是**密集定值**：41 个长度的编码串与解码字节**逐字面量**钉死，
// 给「改内核形态」提供一张更密的网（[S9 §4.3](docs/01-规格/S9-M5语义矩阵与32位装载裁决.md)
// 点名的那张网）。
//
// 【黄金值出处】（AGENTS.md §三.2 铁律 1）
//   · 全部来自 **CPython `base64`**（独立参照，非本库输出）；
//   · 数据式子 = `det_bytes(i) = (i*37+11)&0xFF`；
//   · 生成命令见文件末 [§ 复跑](#复跑)。
//
// 【为什么这里只锁「结果」】
// 内核形态（`for k` 内循环）由 `lib/internal/decode_differential_wbtest.mbt` 锁；
// 本文件只锁**对外可见的结果**，两层合起来才是完整差分。
//
// 台账：[S10](docs/01-规格/S10-去内循环落地与端到端对照.md) §2。

///|
/// 字节序列 → 小写十六进制串（对齐 CPython 的 `bytes.hex()`）。
fn det_to_hex(bytes : Bytes) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder()
  for i = 0; i < bytes.length(); i = i + 1 {
    let v = bytes[i].to_int()
    sb.write_char(digits[(v >> 4) & 0xF].to_int().unsafe_to_char())
    sb.write_char(digits[v & 0xF].to_int().unsafe_to_char())
  }
  sb.to_string()
}

///|
/// 编码侧定值：41 个长度的输出**逐字面量**（黄金值 = CPython `b64encode`）。
///
/// 数据式子 `det_bytes` 复用 `base64_matrix_test.mbt` 里的同源实现
/// （同为黑盒文件、同属 `lib` 包，同名会冲突，故只保留一份）。
test "differential_encode_literals" {
  assert_eq(@lib.encode(det_bytes(0)), "")
  assert_eq(@lib.encode(det_bytes(1)), "Cw==")
  assert_eq(@lib.encode(det_bytes(2)), "CzA=")
  assert_eq(@lib.encode(det_bytes(3)), "CzBV")
  assert_eq(@lib.encode(det_bytes(4)), "CzBVeg==")
  assert_eq(@lib.encode(det_bytes(5)), "CzBVep8=")
  assert_eq(@lib.encode(det_bytes(6)), "CzBVep/E")
  assert_eq(@lib.encode(det_bytes(7)), "CzBVep/E6Q==")
  assert_eq(@lib.encode(det_bytes(8)), "CzBVep/E6Q4=")
  assert_eq(@lib.encode(det_bytes(9)), "CzBVep/E6Q4z")
  assert_eq(@lib.encode(det_bytes(10)), "CzBVep/E6Q4zWA==")
  assert_eq(@lib.encode(det_bytes(11)), "CzBVep/E6Q4zWH0=")
  assert_eq(@lib.encode(det_bytes(12)), "CzBVep/E6Q4zWH2i")
  assert_eq(@lib.encode(det_bytes(13)), "CzBVep/E6Q4zWH2ixw==")
  assert_eq(@lib.encode(det_bytes(14)), "CzBVep/E6Q4zWH2ix+w=")
  assert_eq(@lib.encode(det_bytes(15)), "CzBVep/E6Q4zWH2ix+wR")
  assert_eq(@lib.encode(det_bytes(16)), "CzBVep/E6Q4zWH2ix+wRNg==")
  assert_eq(
    @lib.encode(det_bytes(31)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YQ==",
  )
  assert_eq(
    @lib.encode(det_bytes(32)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYY=",
  )
  assert_eq(
    @lib.encode(det_bytes(33)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar",
  )
  assert_eq(
    @lib.encode(det_bytes(47)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLE=",
  )
  assert_eq(
    @lib.encode(det_bytes(48)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW",
  )
  assert_eq(
    @lib.encode(det_bytes(49)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+w==",
  )
  assert_eq(
    @lib.encode(det_bytes(63)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wB",
  )
  assert_eq(
    @lib.encode(det_bytes(64)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJg==",
  )
  assert_eq(
    @lib.encode(det_bytes(97)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6w==",
  )
  assert_eq(
    @lib.encode(det_bytes(127)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQQ==",
  )
  assert_eq(
    @lib.encode(det_bytes(128)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQWY=",
  )
  assert_eq(
    @lib.encode(det_bytes(129)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQWaL",
  )
  assert_eq(
    @lib.encode(det_bytes(130)),
    "CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQWaLsA==",
  )
  assert_eq(
    @lib.encode(det_bytes(255)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(256)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(257)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(511)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(512)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(513)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(1023)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(1024)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(1025)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(4095)),
    "",
  )
  assert_eq(
    @lib.encode(det_bytes(4096)),
    "",
  )
}

///|
/// 解码侧定值：同一批串解出的字节**逐字面量**（黄金值 = CPython `bytes.hex()`）。
///
/// 与编码侧配成一对**往返锚点**：一条错、另一条必然跟着红。
test "differential_decode_literals" {
  assert_eq(det_to_hex(@lib.decode(b"Cw=="[:]).unwrap()), "0b")
  assert_eq(det_to_hex(@lib.decode(b"CzA="[:]).unwrap()), "0b30")
  assert_eq(det_to_hex(@lib.decode(b"CzBV"[:]).unwrap()), "0b3055")
  assert_eq(det_to_hex(@lib.decode(b"CzBVeg=="[:]).unwrap()), "0b30557a")
  assert_eq(det_to_hex(@lib.decode(b"CzBVep8="[:]).unwrap()), "0b30557a9f")
  assert_eq(det_to_hex(@lib.decode(b"CzBVep/E"[:]).unwrap()), "0b30557a9fc4")
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q=="[:]).unwrap()),
    "0b30557a9fc4e9",
  )
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q4="[:]).unwrap()),
    "0b30557a9fc4e90e",
  )
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q4z"[:]).unwrap()),
    "0b30557a9fc4e90e33",
  )
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q4zWA=="[:]).unwrap()),
    "0b30557a9fc4e90e3358",
  )
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q4zWH0="[:]).unwrap()),
    "0b30557a9fc4e90e33587d",
  )
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q4zWH2i"[:]).unwrap()),
    "0b30557a9fc4e90e33587da2",
  )
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q4zWH2ixw=="[:]).unwrap()),
    "0b30557a9fc4e90e33587da2c7",
  )
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q4zWH2ix+w="[:]).unwrap()),
    "0b30557a9fc4e90e33587da2c7ec",
  )
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q4zWH2ix+wR"[:]).unwrap()),
    "0b30557a9fc4e90e33587da2c7ec11",
  )
  assert_eq(
    det_to_hex(@lib.decode(b"CzBVep/E6Q4zWH2ix+wRNg=="[:]).unwrap()),
    "0b30557a9fc4e90e33587da2c7ec1136",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YQ=="[:]).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c61",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYY="[:]).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar"[:]).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186ab",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLE="[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW"[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+w=="[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wB"[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJg=="[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc0126",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6w=="[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQQ=="[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb10355a7fa4c9ee13385d82a7ccf1163b6085aacff4193e6388add2f71c41",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQWY="[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb10355a7fa4c9ee13385d82a7ccf1163b6085aacff4193e6388add2f71c4166",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQWaL"[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb10355a7fa4c9ee13385d82a7ccf1163b6085aacff4193e6388add2f71c41668b",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJktwlbrfBClOc5i94gcsUXabwOUKL1R5nsPoDTJXfKHG6xA1Wn+kye4TOF2Cp8zxFjtgharP9Bk+Y4it0vccQWaLsA=="[:],
      ).unwrap(),
    ),
    "0b30557a9fc4e90e33587da2c7ec11365b80a5caef14395e83a8cdf2173c6186abd0f51a3f6489aed3f81d42678cb1d6fb20456a8fb4d9fe23486d92b7dc01264b7095badf04294e7398bde2072c51769bc0e50a2f54799ec3e80d32577ca1c6eb10355a7fa4c9ee13385d82a7ccf1163b6085aacff4193e6388add2f71c41668bb0",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b""[:],
      ).unwrap(),
    ),
    "",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b""[:],
      ).unwrap(),
    ),
    "",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b""[:],
      ).unwrap(),
    ),
    "",
  )
  assert_eq(
    det_to_hex(
      @lib.decode(
        b""[:],
      ).unwrap(),
    ),
    "",
